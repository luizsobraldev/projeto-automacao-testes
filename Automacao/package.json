{
  "name": "fnr-testes-playwright",
  "version": "1.0.0",
  "description": "Testes automatizados com Playwright para o sistema FNR Controle de Vendas",
  "scripts": {
    "test": "playwright test tests/clientes.spec.ts tests/produtos.spec.ts",
    "test:headed": "playwright test tests/clientes.spec.ts tests/produtos.spec.ts --headed",
    "test:bugs": "playwright test tests/bugs-evidencias.spec.ts --grep \"@bugs\" --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}